{
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [{ "source": "/uploads/:id", "destination": "/api/img?id=:id" }],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "same-origin" }] },
    { "source": "/admin", "headers": [{ "key": "X-Frame-Options", "value": "DENY" }, { "key": "Cache-Control", "value": "no-store" }] }
  ]
}
